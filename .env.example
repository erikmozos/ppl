# Firebase (copia a .env.local; los valores salen de: firebase apps:sdkconfig WEB <appId>)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cuenta que será administradora (también se usa al generar firestore.rules)
VITE_ADMIN_EMAIL=
